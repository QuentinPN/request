# Copier en .env (jamais commité). Seul DOMAIN est obligatoire.

# Nom de domaine public : Caddy y obtient le certificat HTTPS.
DOMAIN=demandes.example.com

# Sous-réseau Docker du réseau Caddy <-> appli ; l'appli ne croit les en-têtes X-Forwarded-* que de ce sous-réseau
# (TRUST_PROXY). À changer seulement s'il chevauche un réseau existant de l'hôte.
#PROXY_SUBNET=172.28.80.0/24

# Taille maximale du cache d'images sur disque, en Mio (défaut 500).
#IMAGE_CACHE_MAX_MB=500

# Sauvegardes quotidiennes de la base conservées dans /data/backups (défaut 7 ; 0 = désactivées).
#BACKUP_KEEP=7

# Jeton d'installation demandé par l'assistant tant qu'aucun propriétaire n'existe (défaut : tiré au hasard à chaque
# démarrage et écrit dans les journaux : docker compose logs request).
#SETUP_TOKEN=
