{
  "name": "request",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "start": "bun src/server/index.ts",
    "lint": "biome check .",
    "format": "biome check --write . && bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check",
    "test": "bun test --isolate --parallel=6 --randomize",
    "verify": "bun run lint && bun run format:check && bun run check && bun run test && bun run build",
    "backup": "bun scripts/backup.ts",
    "openapi": "bun scripts/openapi.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lucide-react": "^1.73.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sinonjs/fake-timers": "15.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
